# ChenSage_MVP1.0 ignore rules

# Python
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secrets
.env
.env.*
!.env.example

# Runtime data
data/
logs/
*.db
*.sqlite
*.sqlite3

# Generated local artifacts
*.log
next-*-dev.log
next-*-dev.err.log

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Large local outputs
*.zip
*.tar
*.tar.gz
