APP_ENV=development
APP_NAME=ChenSage_MVP1.0
API_HOST=127.0.0.1
API_PORT=8000

# Local SQLite database for MVP development.
DATABASE_URL=sqlite:///./data/sqlite/chenshu_ai.db

UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
LOG_DIR=./logs/api

# Change this before any public deployment.
SECRET_KEY=change-me-in-production
ENABLE_AUTH=false

# Optional default model config. You can also configure models in the web UI.
DEFAULT_MODEL_PROVIDER=openai_compatible
DEFAULT_MODEL_BASE_URL=
DEFAULT_MODEL_NAME=
DEFAULT_MODEL_API_KEY=
TASK_RUN_TIMEOUT_MINUTES=30

# Web app
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
